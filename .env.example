# Database
POSTGRES_USER=mensetu
POSTGRES_PASSWORD=mensetu_dev_pass
POSTGRES_DB=mensetu_ai

# Ollama
# 【推奨】Ollama は Docker Compose の対象外。ホスト側でネイティブ起動する
# （Mac: brew install ollama && ollama serve / Windows: ollama.com のインストーラーを
# 実行すれば常駐サービスとして自動起動）。ホストの全 RAM（Macは追加でMetal GPU）が使え、
# Docker上のCPU動作より桁違いに速く、IDE等との同時起動によるメモリ不足も避けられる。
# ホストで直接 `./gradlew bootRun` する場合はこのまま http://localhost:11434 でよい。
# devcontainer から使う場合は docker-compose.dev.yml が既定で
# http://host.docker.internal:11434（ホストのOllama）に向ける。
#
# 【NVIDIA GPU搭載Windows機の代替】CPUが非力でもGPUがあれば
# `docker compose --profile ollama-gpu up -d` でGPU対応のOllamaコンテナを使う方が速い。
# ホストのポート11434に公開されるので、このデフォルト値のままで到達できる。
OLLAMA_BASE_URL=http://localhost:11434
# 会話・企業リサーチの要約・質問生成すべてで使用するモデル。
# 現在の開発機ではネイティブ実行のため llama3.2:3b を既定にする。
# Docker上でCPU動作させる等メモリに余裕がない環境では llama3.2:1b に落とす。
# GPU がある環境（RTX 3060等）では llama3.1:8b 等に上げる。日本語重視なら qwen2.5:3b/7b も可。
OLLAMA_MODEL=llama3.2:3b

# Whisper (STT)
WHISPER_BASE_URL=http://localhost:8000
WHISPER_MODEL=base

# VOICEVOX (TTS)
VOICEVOX_BASE_URL=http://localhost:50021

# 企業ソース(URL登録→サーバーが直接fetchして本文抽出。APIキー不要)
SOURCES_FETCH_TIMEOUT_MS=10000

# Backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
